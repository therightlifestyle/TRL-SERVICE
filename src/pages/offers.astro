---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Notice from '../components/Notice.astro';
import OfferCard from '../components/OfferCard.astro';
import PageIntro from '../components/PageIntro.astro';
import SectionIntro from '../components/SectionIntro.astro';
import StepList from '../components/StepList.astro';
import { contact, engagementSteps, offers } from '../lib/site';
---

<BaseLayout
  title="Offers and pricing"
  description="Three TRL engagements with published prices: the Micro Audit at $35 / PKR 9,900, the Builder Automation Setup at $499, and the Transformation / Founder OS at $1,297."
  whatsappMessage="Hello TRL, I have a question about your offers: "
>
  <PageIntro
    eyebrow="Offers"
    heading="Published prices, written scope, no discovery-call maze"
    lead="Three engagements, in order of commitment. Each one lists what you get, what is included, and what is not, before you speak to anyone."
  />

  <section class="section" aria-labelledby="offers-heading">
    <div class="container container--wide">
      <h2 id="offers-heading" class="visually-hidden">The three offers</h2>
      <div class="grid grid--3">
        {offers.map((offer) => <OfferCard offer={offer} headingLevel={3} />)}
      </div>
    </div>
  </section>

  <section class="section section--muted" aria-labelledby="steps-heading">
    <div class="container">
      <SectionIntro
        eyebrow="After you enquire"
        heading="What happens next"
        id="steps-heading"
      />
      <div class="steps__body">
        <StepList steps={engagementSteps} />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="terms-heading">
    <div class="container container--reading stack-6">
      <h2 id="terms-heading">Payment and practicalities</h2>
      <Notice tone="info" heading="How payment works today">
        <p>
          There is no checkout on this site yet. After we agree the scope in writing,
          payment details are sent to you directly. Prices are quoted in US dollars; the
          Micro Audit is also quoted in Pakistani rupees.
        </p>
      </Notice>
      <ul class="list">
        <li>
          Third-party software subscriptions and API usage are billed by those providers
          to you, not by TRL.
        </li>
        <li>
          Scope is agreed before work starts. Changes after that are quoted separately
          rather than absorbed silently.
        </li>
        <li>
          Prices shown are for the engagements described here. Anything outside them is
          quoted individually.
        </li>
      </ul>
      <p>
        Not sure which one fits? Describe the problem and we will tell you — including
        if the answer is none of them. Email
        <a href={`mailto:${contact.email}`}>{contact.email}</a> or use the contact page.
      </p>
      <p>
        <Button href="/contact/" fullWidthOnMobile>Contact TRL</Button>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .list {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding-inline-start: var(--space-6);
    max-width: var(--measure-body);
  }

  .steps__body {
    margin-block-start: var(--space-12);
  }
</style>
