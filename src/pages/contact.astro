---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import ErrorSummary from '../components/ErrorSummary.astro';
import Field from '../components/Field.astro';
import Notice from '../components/Notice.astro';
import PageIntro from '../components/PageIntro.astro';
import { env as cfEnv } from 'cloudflare:workers';
import { contact, mailtoLink, whatsappLink } from '../lib/site';
import {
  createContactDeps,
  FIELD_ORDER,
  handleContactPost,
  SERVICE_OPTIONS,
  type ContactFieldErrors,
  type RawContactValues,
} from '../lib/contact';

/*
 * Gate 4: this page is the contact endpoint (D-005 — the one server route).
 * It prerenders nothing; GET renders the form and POST processes the
 * submission. Same-origin enforcement is provided by Astro's built-in
 * `checkOrigin`, which rejects form POSTs with a missing or foreign Origin
 * before this component runs. All submission logic lives in src/lib/contact.ts.
 */

const method = Astro.request.method;
const sitekey = (cfEnv.PUBLIC_TURNSTILE_SITEKEY ?? '').trim();

interface FormState {
  status: number;
  values: RawContactValues;
  fieldErrors: ContactFieldErrors;
  formError?: 'verification' | 'unavailable';
}

let formState: FormState = {
  status: 200,
  values: { name: '', email: '', service: '', message: '', phone: '', business: '' },
  fieldErrors: {},
};

if (method === 'POST') {
  const result = await handleContactPost(Astro.request, { ...cfEnv }, createContactDeps());
  if (result.outcome === 'redirect') {
    return Astro.redirect(result.location, 303);
  }
  formState = {
    status: result.status,
    values: { ...formState.values, ...result.values },
    fieldErrors: result.fieldErrors ?? {},
    formError: result.formError,
  };
} else if (method !== 'GET' && method !== 'HEAD') {
  return new Response(null, { status: 405, headers: { Allow: 'GET, POST' } });
}

Astro.response.status = formState.status;

const { values, fieldErrors, formError } = formState;

/* Error summary entries follow the visual order of the form. */
const summaryErrors = FIELD_ORDER.filter((field) => fieldErrors[field]).map((field) => ({
  href: `#${field}`,
  text: fieldErrors[field]!,
}));

if (formError === 'verification') {
  summaryErrors.push({
    href: '#turnstile',
    text: 'We could not verify that your message comes from a person. Please try again.',
  });
}

const configured = sitekey !== '';
---

<BaseLayout
  title="Contact"
  description="Contact TRL by email at officialtrlservice@gmail.com or on WhatsApp at +92 3190091457 to discuss AI automation and business systems for your business."
  whatsappMessage="Hello TRL, I would like to discuss a workflow in my business: "
>
  <PageIntro
    eyebrow="Contact"
    heading="Describe the workflow. We will tell you honestly whether we can help."
    lead="Messages reach the founder directly. Include what the process is, roughly how often it happens, and what it costs you in time."
  />

  <section class="section contact__channels" aria-labelledby="channels-heading">
    <div class="container">
      <h2 id="channels-heading">Direct channels</h2>
      <div class="grid grid--2 channels__grid">
        <article class="channel">
          <h3>WhatsApp</h3>
          <p class="muted">Fastest for a short question or a quick description.</p>
          <p>
            <a
              class="channel__link"
              href={whatsappLink(
                'Hello TRL, I would like to discuss a workflow in my business: ',
              )}
            >
              {contact.whatsappNumber}
            </a>
          </p>
        </article>

        <article class="channel">
          <h3>Email</h3>
          <p class="muted">Better for detail, documents, or a written scope.</p>
          <p>
            <a class="channel__link" href={mailtoLink('Enquiry via the TRL website')}>
              {contact.email}
            </a>
          </p>
        </article>
      </div>
      <p class="text-small muted channels__note">
        We do not publish a guaranteed response time, because we are not yet in a
        position to promise one honestly.
      </p>
    </div>
  </section>

  <section class="section section--muted" aria-labelledby="form-heading">
    <div class="container container--reading stack-8">
      <div class="stack">
        <h2 id="form-heading">Enquiry form</h2>
        <p class="muted">
          Or send the form below. Every field marked <strong>Required</strong> must be
          filled in; the rest help us answer faster.
        </p>
      </div>

      {
        !configured && (
          <Notice tone="warning" heading="The form is not available on this deployment">
            <p>
              This copy of the site is missing its verification configuration, so the
              form cannot accept submissions. Please use WhatsApp or email above —
              both reach the founder directly.
            </p>
          </Notice>
        )
      }

      {
        formError === 'unavailable' && (
          <Notice tone="error" heading="Your message was not sent">
            <p>
              Something went wrong on our side, and we could not send it. Your text is
              still in the form below — try again in a moment, or send it by{' '}
              <a href={whatsappLink('Hello TRL, I would like to discuss a workflow in my business: ')}>WhatsApp</a>{' '}
              or <a href={mailtoLink('Enquiry via the TRL website')}>email</a> instead.
            </p>
          </Notice>
        )
      }

      {summaryErrors.length > 0 && <ErrorSummary errors={summaryErrors} />}

      <form class="form" method="post" action="/contact/" novalidate>
        <fieldset class="form__fieldset" disabled={!configured}>
          <legend class="visually-hidden">Enquiry details</legend>

          <Field
            id="name"
            name="name"
            label="Your name"
            required
            maxlength={120}
            autocomplete="name"
            value={values.name}
            error={fieldErrors.name}
          />

          <Field
            id="email"
            name="email"
            label="Email address"
            type="email"
            required
            maxlength={200}
            autocomplete="email"
            hint="We reply to this address."
            value={values.email}
            error={fieldErrors.email}
          />

          <Field
            id="service"
            name="service"
            label="Service of interest"
            type="select"
            required
            options={SERVICE_OPTIONS}
            value={values.service}
            error={fieldErrors.service}
          />

          <Field
            id="message"
            name="message"
            label="What would you like to change?"
            type="textarea"
            required
            minlength={20}
            maxlength={4000}
            hint="Describe the workflow, how often it runs, and what it currently costs you."
            value={values.message}
            error={fieldErrors.message}
          />

          <Field
            id="phone"
            name="phone"
            label="WhatsApp or phone"
            type="tel"
            maxlength={40}
            autocomplete="tel"
            value={values.phone}
            error={fieldErrors.phone}
          />

          <Field
            id="business"
            name="business"
            label="Business name"
            maxlength={120}
            autocomplete="organization"
            value={values.business}
            error={fieldErrors.business}
          />

          {
            /* Hidden anti-spam field: humans never see it and never fill it in. */
            <div class="honeypot" aria-hidden="true">
              <label for="website">Website</label>
              <input
                id="website"
                name="website"
                type="text"
                tabindex="-1"
                autocomplete="off"
              />
            </div>
          }

          {
            configured && (
              <div class="form__turnstile" id="turnstile" tabindex="-1">
                <div
                  class="cf-turnstile"
                  data-sitekey={sitekey}
                  data-theme="light"
                  data-size="compact"
                />
              </div>
            )
          }

          <p class="text-small muted">
            We use what you send only to answer your enquiry. The form is checked by
            Cloudflare Turnstile to keep out automated spam. See the
            <a href="/privacy/">privacy page</a>.
          </p>

          <Button type="submit" fullWidthOnMobile>Send enquiry</Button>
        </fieldset>
      </form>
    </div>
  </section>

  {
    configured && (
      <script
        is:inline
        src="https://challenges.cloudflare.com/turnstile/v0/api.js"
        async defer
      />
    )
  }

  <noscript>
    <section class="section" aria-labelledby="noscript-heading">
      <div class="container container--reading">
        <h2 id="noscript-heading">Sending the form needs JavaScript</h2>
        <p>
          The form's spam check runs in your browser, so it cannot be submitted
          without JavaScript. WhatsApp and email at the top of this page work
          without it and reach the same person.
        </p>
      </div>
    </section>
  </noscript>
</BaseLayout>

<style>
  .contact__channels h2 {
    max-width: 24ch;
  }

  .channels__grid {
    margin-block-start: var(--space-8);
  }

  .channel {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-6);
    background-color: var(--color-surface);
    border: var(--border-default);
    border-radius: var(--radius-md);
  }

  .channel__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    font-size: var(--text-lead);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }

  .channels__note {
    margin-block-start: var(--space-6);
  }

  .form__fieldset {
    display: grid;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    border: 0;
  }

  /* Unconfigured deployments render the form inert, never mistakable for live. */
  .form__fieldset[disabled] {
    opacity: 0.75;
  }

  .form__turnstile {
    display: flex;
    min-height: var(--control-height);
    align-items: flex-start;
  }

  .form__turnstile:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  /* The honeypot is removed from view and from assistive technology, but stays
     in the markup so naive bots fill it in. Never apply display:none here. */
  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>
