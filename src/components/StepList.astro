---
import type { Step } from '../lib/site';

interface Props {
  steps: readonly Step[];
  /** Numbered sequence (process) or unnumbered principles. */
  numbered?: boolean;
  headingLevel?: 3 | 4;
}

const { steps, numbered = true, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h3' | 'h4';
const List = numbered ? 'ol' : 'ul';
---

<List class:list={['steps', numbered && 'steps--numbered']}>
  {
    steps.map((step, index) => (
      <li class="steps__item">
        {numbered && (
          <span class="steps__index tabular" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
        )}
        <div class="steps__content">
          <Heading class="steps__title">{step.title}</Heading>
          <p class="muted">{step.body}</p>
        </div>
      </li>
    ))
  }
</List>

<style>
  .steps {
    display: grid;
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }

  .steps__item {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
  }

  .steps--numbered .steps__item {
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    align-items: start;
  }

  .steps__index {
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.3;
    color: var(--color-action);
  }

  .steps__content > * + * {
    margin-block-start: var(--space-2);
  }

  @media (min-width: 64rem) {
    .steps--numbered {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-12) var(--space-8);
    }
  }
</style>
