---
/**
 * Abstract systems graphic (D-009): thin paths, junctions, nodes, and a single
 * highlighted route through them. Purely decorative — it is aria-hidden and
 * carries no information that is not already stated in adjacent text. It uses
 * palette tokens only and shows no fabricated data, metric, or interface.
 */
interface Props {
  variant?: 'route' | 'grid';
  class?: string;
}

const { variant = 'route', class: className } = Astro.props;
---

<div class:list={['systems-graphic', className]} aria-hidden="true">
  {
    variant === 'route' ? (
      <svg viewBox="0 0 320 220" role="presentation" focusable="false">
        <g class="sg-line">
          <path d="M24 44h96" />
          <path d="M24 110h64" />
          <path d="M24 176h96" />
          <path d="M120 44v66" />
          <path d="M120 176v-66" />
          <path d="M88 110h112" />
          <path d="M200 110h-48" />
          <path d="M200 110v-48h72" />
          <path d="M200 110v48h72" />
        </g>
        <g class="sg-path">
          <path d="M24 110h96v-66h0" />
          <path d="M120 44h80v18" />
          <path d="M200 62h72" />
        </g>
        <g class="sg-node">
          <circle cx="24" cy="44" r="5" />
          <circle cx="24" cy="110" r="5" />
          <circle cx="24" cy="176" r="5" />
          <circle cx="120" cy="110" r="5" />
          <circle cx="200" cy="158" r="5" />
        </g>
        <g class="sg-node sg-node--active">
          <circle cx="120" cy="44" r="6" />
          <circle cx="200" cy="62" r="6" />
          <circle cx="272" cy="62" r="6" />
        </g>
        <g class="sg-frame">
          <rect x="146" y="88" width="108" height="44" rx="6" />
        </g>
      </svg>
    ) : (
      <svg viewBox="0 0 320 220" role="presentation" focusable="false">
        <g class="sg-frame">
          <rect x="16" y="20" width="132" height="80" rx="6" />
          <rect x="172" y="20" width="132" height="80" rx="6" />
          <rect x="16" y="120" width="132" height="80" rx="6" />
          <rect x="172" y="120" width="132" height="80" rx="6" />
        </g>
        <g class="sg-line">
          <path d="M148 60h24" />
          <path d="M82 100v20" />
          <path d="M238 100v20" />
          <path d="M148 160h24" />
        </g>
        <g class="sg-path">
          <path d="M48 60h68" />
          <path d="M204 60h68" />
        </g>
        <g class="sg-node sg-node--active">
          <circle cx="48" cy="60" r="5" />
          <circle cx="272" cy="60" r="5" />
        </g>
        <g class="sg-node">
          <circle cx="82" cy="160" r="5" />
          <circle cx="238" cy="160" r="5" />
        </g>
      </svg>
    )
  }
</div>

<style>
  .systems-graphic {
    width: 100%;
  }

  .systems-graphic svg {
    width: 100%;
    height: auto;
  }

  .sg-line path {
    fill: none;
    stroke: var(--color-border);
    stroke-width: 1.25;
  }

  .sg-path path {
    fill: none;
    stroke: var(--color-action);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .sg-node circle {
    fill: var(--color-canvas);
    stroke: var(--color-border);
    stroke-width: 1.5;
  }

  .sg-node--active circle {
    fill: var(--color-action);
    stroke: var(--color-action);
  }

  .sg-frame rect {
    fill: none;
    stroke: var(--color-border);
    stroke-width: 1.25;
    stroke-dasharray: 4 4;
  }

  /* Meaning never depends on the graphic, so it may simplify away entirely. */
  @media (forced-colors: active) {
    .systems-graphic {
      display: none;
    }
  }
</style>
