# Canonical production origin used for metadata, canonical URLs, and the sitemap.
PUBLIC_SITE_URL="https://therightlifestyle.com"

# Runtime variables for the contact endpoint (Gate 4). Set only as encrypted
# environment variables in the hosting platform — never commit real values.
# Local development and e2e use the dummy keys in .dev.vars.example instead.
#
# PUBLIC_TURNSTILE_SITEKEY=""  # Turnstile sitekey rendered into the form
# TURNSTILE_SECRET=""          # Turnstile secret for server-side verification
# RESEND_API_KEY=""            # Resend API key for email delivery
# CONTACT_TO_EMAIL="officialtrlservice@gmail.com"  # approved destination (D-003)
# RESEND_FROM_EMAIL=""         # verified sender address (e.g. hello@therightlifestyle.com)
